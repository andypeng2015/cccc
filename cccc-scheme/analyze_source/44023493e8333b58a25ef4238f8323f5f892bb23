; Cognitive: do(+1) + nested do(+2) + cond clause(se rather than a labelled continue.)
(define (sum-of-primes max)
  (define total 0)
  (do ((i 2 (+ i 1)))
      ((> i max) total)
    (do ((j 2 (+ j 1)))
        ((>= j i))
      (cond ((= (modulo i j) 0) (set! total total))
            (else (set! total (+ total i)))))))

