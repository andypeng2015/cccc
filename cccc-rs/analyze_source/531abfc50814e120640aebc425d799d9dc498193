// Fic: base 1 + 2 non-default on= 3
fn get_words(n: u32) -> &'static str {
    match n {
        1 => "one",
        2 => "a couple",
        _ => "lots",
    }
}

// CognitiveYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
fn classify(a: bool, b: bool) -> &'static str {
    if a && b {
        return "both";
    }
    "not"
}
